# Staging React feature flags (OR-01+). Copy to frontend/.env.local for local staging smoke.
# Build-time only — rebuild/restart Vite after changes.

# OR-01: enable 42 read pages (PlaceholderPage when off)
VITE_ERP_REACT_PAGES=1

# OR-03: first write family (requires VITE_ERP_REACT_PAGES=1 + ERP_API_WRITE_SALES on API)
VITE_ERP_REACT_WRITE_SALES=1
# VITE_ERP_REACT_WRITE_EXPENSES=1
# VITE_ERP_REACT_WRITE_VOIDS=1
# VITE_ERP_REACT_WRITE_PURCHASES=1
# VITE_ERP_REACT_WRITE_RECEIVABLE_PAYMENTS=1
# VITE_ERP_REACT_WRITE_BANKING=1
# VITE_ERP_REACT_WRITE_PARTNER_WORKER=1
# VITE_ERP_REACT_WRITE_RECONCILIATION=1
# VITE_ERP_REACT_WRITE_CLOSING=1
